# FluxVLA-Tron2 environment template.
# Copy values from this file into your shell or into a private .env file.
# Do not commit real secrets, API tokens, robot account IDs, or private hosts.

# Training device selection.
CUDA_VISIBLE_DEVICES=0,1,2,3
NPROC_PER_NODE=4

# Distributed training defaults for a single machine.
WORLD_SIZE=1
RANK=0
MASTER_ADDR=localhost
MASTER_PORT=29500

# Weights & Biases logging. Leave WANDB_ENTITY empty unless your organization
# requires it. This repository does not require WANDB_API_KEY in .env; use
# `wandb login` or your platform secret manager instead.
WANDB_PROJECT=fluxvla-tron2
WANDB_ENTITY=
WANDB_MODE=online

# Optional TensorBoard output path. Leave empty to use runner defaults.
TENSORBOARD_LOG_PATH=

# Optional cache directories. Use local writable paths on shared clusters or
# robot-side machines with restricted home directories.
OPENPI_DATA_HOME=.cache/openpi
HF_LEROBOT_HOME=datasets
NUMBA_CACHE_DIR=.cache/numba
MPLCONFIGDIR=.cache/matplotlib

# Build option for CUDA extensions. Set to 1 only when CUDA build tooling is
# available and you want to force CUDA extension compilation.
FORCE_CUDA=0

# Remote robot client mode. Keep 0 for normal training/server use. Set to 1
# only on the Power Computing Module when running the lightweight remote
# inference client without importing full training/model modules.
FLUXVLA_REMOTE_CLIENT_ONLY=0

# Optional acceleration knobs used by selected third-party model components.
ENABLE_TENSORRT=False
ATTENTION_BACKEND=
